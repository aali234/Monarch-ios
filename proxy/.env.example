PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
APP_KEY=
ENABLE_SANDBOX_TOOLS=true
# Optional for the non-OAuth Sandbox bank. Required for OAuth institutions.
# Register this HTTPS Universal Link in Plaid Dashboard and in app entitlements.
PLAID_REDIRECT_URI=
ALLOW_PRODUCTION=false
# Optional: Ship24 API key for live shipment status. Receipt import works without it.
SHIP24_API_KEY=
